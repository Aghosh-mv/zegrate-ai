{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 300 }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/status", "dest": "api/status.py" },
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "/static/index.html" }
  ],
  "headers": [
    { "source": "/api/training-stream", "headers": [{"key": "Cache-Control", "value": "no-cache"}, {"key": "X-Accel-Buffering", "value": "no"}] }
  ]
}
